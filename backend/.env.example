# Обязательные настройки
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/DB_NAME

# Секрет для подписи JWT, минимум 32 символа. Сгенерировать:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=CHANGE_ME_TO_A_RANDOM_STRING_OF_32_OR_MORE_CHARS

# Пароль демо-пользователя для python -m app.seed, минимум 8 символов
SEED_USER_PASSWORD=CHANGE_ME_PLEASE

# Необязательные настройки (значения по умолчанию)
# ENVIRONMENT=development
# LOG_LEVEL=INFO
# ACCESS_TOKEN_EXPIRE_MINUTES=15
# REFRESH_TOKEN_EXPIRE_DAYS=30
# REFRESH_COOKIE_SECURE=false
# UPLOAD_DIR=uploads
# LOGIN_MAX_ATTEMPTS=5
# LOGIN_BLOCK_MINUTES=15
