# Настройки для запуска через Docker Compose. Скопируйте в файл .env и замените значения.

POSTGRES_PASSWORD=CHANGE_ME

# Минимум 32 символа. Сгенерировать:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=CHANGE_ME_TO_A_RANDOM_STRING_OF_32_OR_MORE_CHARS

# Порт, на котором откроется сайт
APP_PORT=8080

# true — cookie передаётся только по HTTPS, обязательно для настоящего сервера.
# false — только для локальной проверки по HTTP.
REFRESH_COOKIE_SECURE=true

# Необязательно: пароль демо-пользователя для docker compose exec backend python -m app.seed
SEED_USER_PASSWORD=
